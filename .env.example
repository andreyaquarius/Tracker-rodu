VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_PICKER_API_KEY=your_browser_restricted_google_picker_api_key
VITE_GOOGLE_DRIVE_APP_ID=your_google_cloud_project_number

# Optional override of the PUBLIC DSN already configured in .env.production.
# Development (`npm run dev`) does not send events. To disable production
# reporting, set VITE_SENTRY_ENABLED=false and rebuild.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production
# CI fills this from the commit SHA; optional when building locally.
VITE_SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN is a build-only secret for private source-map uploads.
# Set it with SENTRY_ORG and SENTRY_PROJECT in CI, NEVER as a VITE_ variable.
# Optional public bot username, e.g. TrackerRoduBot. Never put Telegram API
# tokens or webhook/worker secrets in any VITE_ variable.
VITE_TELEGRAM_BOT_USERNAME=your_tracker_rodu_bot

# Emergency build-time kill switch. The database feature flag must also be on.
VITE_EXTERNAL_PDF_VIEWER_V2=true
VITE_EXTERNAL_PDF_SOURCE_REVALIDATE_MINUTES=15

# Browser-side PDF export limits. Larger PDFs/ranges should use the future
# server streaming strategy instead of being fully materialized in memory.
VITE_PDF_CLIENT_EXPORT_MAX_BYTES=134217728
VITE_PDF_CLIENT_EXPORT_MAX_PAGES=100
VITE_PDF_EXPORT_MAX_IMAGE_SIDE=4096
VITE_PDF_EXPORT_IMAGE_SCALE=2
VITE_PDF_EXPORT_MAX_ZIP_PIXELS=80000000
VITE_PDF_EXPORT_MAX_ZIP_MEMORY_BYTES=402653184
VITE_PDF_VIEWER_RANGE_CHUNK_SIZE=1048576
VITE_PDF_VIEWER_MAX_DEVICE_PIXEL_RATIO=2
VITE_PDF_VIEWER_MAX_RENDER_SCALE=4
VITE_PDF_VIEWER_MAX_CONCURRENT_RENDERS=1
VITE_PDF_VIEWER_MAX_CANVAS_PIXELS=16777216
VITE_PDF_VIEWER_MAX_CANVAS_SIDE=8192

# Optional: route Edge Function calls to locally served Supabase functions while testing.
# Leave disabled for normal deployed-function behavior.
# VITE_LOCAL_EDGE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
