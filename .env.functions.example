APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required for private Google Drive PDF gateway sessions. Use the same
# server-only AES-GCM key configured for encrypted integrations (32+ random
# bytes). Never expose it as a VITE_ variable.
ENCRYPTION_KEY=replace-with-a-long-random-server-secret

# Optional PDF gateway resource limits.
PDF_PROXY_TOKEN_TTL_SECONDS=600
PDF_PROXY_MAX_REDIRECTS=4
PDF_PROXY_CONNECT_TIMEOUT_MS=15000
PDF_PROXY_STREAM_IDLE_TIMEOUT_MS=30000
PDF_FALLBACK_MAX_BYTES_WITHOUT_RANGE=33554432
PDF_PROXY_MAX_RANGE_RESPONSE_BYTES=8388608
PDF_PROXY_MAX_REQUESTS_PER_SESSION=512
PDF_PROXY_MAX_ACTIVE_SESSIONS_PER_USER_PROJECT=8
PDF_PROBE_MAX_REQUESTS_PER_WINDOW=30
PDF_PROBE_WINDOW_SECONDS=60
PDF_TELEMETRY_MAX_EVENTS_PER_WINDOW=120
PDF_TELEMETRY_WINDOW_SECONDS=60
PDF_TELEMETRY_SUCCESS_SAMPLE_PERCENT=10
PDF_PROXY_MAX_REQUEST_BODY_BYTES=8192
